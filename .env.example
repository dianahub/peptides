# Production database (Railway Postgres)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Staging database — used by `npm run migrate:staging` and seed scripts
STAGING_DATABASE_URL=postgresql://user:password@host:port/dbname

# Admin auth
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CRON_SECRET=
IP_HASH_SALT=

# Optional
RESEND_API_KEY=
AFFILIATE_URL=
